# Copy this file to `.env.local` (Vercel/CLI) and fill in your values.
# `.env*` files are gitignored — never commit real secrets.

# --- Groq AI (required for AI features on the serverless proxy) ---
# Get a key at https://console.groq.com
GROQ_API_KEY=

# --- Supabase (cloud sync, leaderboard, mates) ---
# Project credentials from https://supabase.com/dashboard
SUPABASE_URL=
# Public anon key (safe to embed in the client; RLS still enforces access).
SUPABASE_ANON_KEY=
# Service role key (server-side ONLY — used by api/mates.js; never expose to clients).
SUPABASE_SERVICE_KEY=

# --- Upstash Redis (optional; durable rate limiting across serverless instances) ---
# Without these the app falls back to per-instance in-memory rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Origin allowlist for the API endpoints (comma-separated) ---
# Defaults to https://study-hub-plum-omega.vercel.app when unset.
#ALLOWED_ORIGINS=https://study-hub-plum-omega.vercel.app

# --- Google OAuth (optional; Google Classroom / Calendar integration) ---
#GOOGLE_CLIENT_ID=
#NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Vercel (optional; injected by the CLI/CI, not meant to be hand-set) ---
#VERCEL_OIDC_TOKEN=
