{
  "name": "study-hub",
  "version": "1.1.5",
  "description": "Study Hub - Plan smarter. Practice deeper. Improve daily.",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "desktop:dev": "electron .",
    "desktop:build": "electron-packager . \"Study Hub\" --platform=darwin --arch=universal --icon=assets/icon --overwrite --asar --out=release --app-version=1.0.0",
    "desktop:build-win": "electron-packager . \"Study Hub\" --platform=win32 --arch=x64 --icon=assets/icon --overwrite --asar --out=release",
    "desktop:build-linux": "electron-packager . \"Study Hub\" --platform=linux --arch=x64 --overwrite --asar --out=release",
    "desktop:dmg": "electron-builder --mac dmg",
    "build:mobile": "mkdir -p www && cp index.html styles.css app.js cloud-core.js mobile.js build.js studymap-data.js subject-labs.js www/ && cp -r assets www/ && cp -r music www/",
    "cap:sync": "npm run build:mobile && npx cap sync",
    "cap:ios": "npm run build:mobile && npx cap sync ios && npx cap open ios",
    "cap:android": "npm run build:mobile && npx cap sync android && npx cap open android",
    "test": "node --check app.js && node --check cloud-core.js && node --check electron-main.js && node --check electron-menu.js && node --check electron-window-state.js && node --check electron-updater-core.js && node scripts/window-state-test.js && node scripts/updater-test.js && node scripts/exam-estimator-test.js",
    "test:qa": "electron scripts/qa-smoke.js",
    "cleanup:demo": "node scripts/cleanup-demo-data.js"
  },
  "keywords": [
    "study",
    "education",
    "productivity",
    "ai"
  ],
  "author": {
    "name": "Study Hub",
    "email": "30dimrekatai@student.aisb.hu"
  },
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/local-notifications": "^8.2.1"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.studyhub.desktop",
    "productName": "Study Hub",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!www",
      "!ios",
      "!android",
      "!src-tauri",
      "!downloads",
      "!release",
      "!.freebuff",
      "!.vercel",
      "!.env*",
      "!node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "minimumSystemVersion": "12.0"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Education",
      "maintainer": "Study Hub <30dimrekatai@student.aisb.hu>"
    }
  }
}
