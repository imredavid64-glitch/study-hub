{
  "manifest_version": 3,
  "name": "StudyHub Side Tutor",
  "version": "1.0.0",
  "description": "A Study Hub agent that learns alongside you on any website. Ask it questions, get Socratic guidance, and capture page context.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "activeTab", "tabs", "storage", "scripting"],
  "host_permissions": [
    "https://study-hub-plum-omega.vercel.app/*",
    "https://api.groq.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open StudyHub Side Tutor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}